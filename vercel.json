{
  "version": 2,
  "buildCommand": "bash build_files.sh",
  "outputDirectory": "staticfiles",
  "framework": null,
  "functions": {
    "fstp/wsgi.py": {
      "runtime": "vercel-python@4.x"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "fstp/wsgi.py"
    }
  ]
}
